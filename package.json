{
  "name": "ethio-auto-mini-app",
  "version": "1.0.0",
  "description": "Telegram Mini App Casino",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:miniapp\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:miniapp": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "db:init": "tsx src/database/init.ts",
    "db:push": "tsx src/database/init.ts",
    "start:prod": "node dist/server/index.js",
    "start": "npm run start:prod"
  },
  "dependencies": {
    "@telegram-apps/sdk": "^2.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "crypto": "^1.0.1",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "concurrently": "^8.2.2",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
